:root {
  --ink: #14293d;
  --tide: #1d6a7a;
  --tide-dark: #14505d;
  --glass: #e3efec;
  --brass: #b07d2b;
  --paper: #fafbfa;
  --line: #cfdcd8;
  --alert: #a8392a;
  --ok: #26704a;
  --radius: 10px;
}
* { box-sizing: border-box; }
body { margin: 0; font: 400 1rem/1.55 Figtree, system-ui, sans-serif; color: var(--ink); background: var(--paper); }
h1, h2, h3, .brand { font-family: Fraunces, Georgia, serif; font-weight: 600; line-height: 1.15; margin: 0 0 .6rem; }
h1 { font-size: clamp(2rem, 5vw, 3.4rem); max-width: 16ch; }
h2 { font-size: 1.7rem; }

.top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .8rem clamp(1rem, 4vw, 3rem); border-bottom: 1px solid var(--line); background: #fff; position: sticky; top: 0; z-index: 5; }
.top nav { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; }
.brand { font-size: 1.5rem; color: var(--ink); text-decoration: none; margin: 0; }

main { padding: 0 clamp(1rem, 4vw, 3rem) 4rem; max-width: 1200px; margin: 0 auto; }
.view { padding-top: 1.5rem; }
[hidden] { display: none !important; }

.hero { background: var(--ink); color: #fff; border-radius: var(--radius); padding: clamp(1.2rem, 4vw, 2.5rem); }
.search { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .8rem; align-items: end; margin-top: 1rem; }
.search label { color: #cfe1e6; }

label { display: grid; gap: .25rem; font-size: .9rem; font-weight: 500; }
input, select, textarea { font: inherit; color: var(--ink); padding: .6rem .7rem; border: 1px solid var(--line); border-radius: 8px; background: #fff; width: 100%; }
input:focus-visible, select:focus-visible, textarea:focus-visible, button:focus-visible, a:focus-visible { outline: 3px solid var(--brass); outline-offset: 2px; }

.btn { font: 600 1rem Figtree, sans-serif; background: var(--brass); color: #fff; border: 0; padding: .7rem 1.2rem; border-radius: 8px; cursor: pointer; }
.btn:hover { background: #956922; }
.btn:disabled { opacity: .6; cursor: wait; }
.btn.small { padding: .45rem .9rem; font-size: .9rem; }
.btn.ghost { background: transparent; color: var(--tide-dark); border: 1px solid var(--tide); }
.btn.ghost:hover { background: var(--glass); }
.link { background: none; border: 0; font: 500 .95rem Figtree, sans-serif; color: var(--tide-dark); cursor: pointer; padding: .4rem .6rem; text-decoration: none; }
.link:hover { text-decoration: underline; }

.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 1rem; margin-top: 1rem; }
.room { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem; display: grid; gap: .4rem; align-content: start; }
.room h3 { font-size: 1.2rem; margin: 0; }
.room .price { font-size: 1.4rem; font-weight: 600; color: var(--tide-dark); }
.room .price small { font-size: .85rem; font-weight: 400; color: #4d6270; }
.meta { color: #4d6270; font-size: .92rem; margin: 0; }

.stack { display: grid; gap: .8rem; }
.row { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; }
.card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; align-items: center; }
.card h3 { font-size: 1.1rem; margin: 0 0 .2rem; }

.badge { display: inline-block; padding: .1rem .6rem; border-radius: 99px; font-size: .82rem; font-weight: 600; background: var(--glass); color: var(--tide-dark); }
.badge.Cancelled, .badge.Refunded, .badge.PaymentFailed { background: #f4dcd7; color: var(--alert); }
.badge.CheckedOut { background: #e6e9ee; color: #44505e; }
.badge.Confirmed, .badge.CheckedIn { background: #d9eddf; color: var(--ok); }

.msg { margin: 0; min-height: 1.3em; color: var(--alert); font-weight: 500; }
.msg.ok { color: var(--ok); }
.hint, .summary { margin: 0; font-size: .9rem; color: #4d6270; }
.summary { background: var(--glass); padding: .7rem; border-radius: 8px; color: var(--ink); }

.tabs { display: flex; gap: .3rem; border-bottom: 1px solid var(--line); margin-bottom: 1rem; }
.tab { background: none; border: 0; padding: .6rem 1rem; font: 500 1rem Figtree, sans-serif; cursor: pointer; color: #4d6270; border-bottom: 3px solid transparent; }
.tab.on { color: var(--ink); border-color: var(--brass); }
.inline { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: .6rem; margin-bottom: 1rem; align-items: end; }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1rem; margin-bottom: 1.2rem; }
.stat { border-left: 4px solid var(--tide); padding: .3rem .9rem; }
.stat strong { display: block; font: 600 1.8rem Fraunces, serif; }
table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
th, td { text-align: left; padding: .6rem .8rem; border-bottom: 1px solid var(--line); font-size: .93rem; }
th { background: var(--glass); }
.scroll { overflow-x: auto; }

dialog { border: 0; border-radius: var(--radius); padding: 1.4rem; width: min(440px, 92vw); box-shadow: 0 20px 60px rgba(20, 41, 61, .35); }
dialog::backdrop { background: rgba(20, 41, 61, .55); }

#toast { position: fixed; left: 50%; bottom: 1.2rem; transform: translate(-50%, 150%); background: var(--ink); color: #fff; padding: .7rem 1.2rem; border-radius: 8px; transition: transform .25s; z-index: 20; }
#toast.show { transform: translate(-50%, 0); }

@media (prefers-reduced-motion: reduce) { #toast { transition: none; } }
